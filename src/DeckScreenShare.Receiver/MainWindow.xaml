<Window x:Class="DeckScreenShare.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deck Screen Share" Width="1240" Height="800"
        MinWidth="1040" MinHeight="680"
        Background="#080B14" Foreground="#F6F8FF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="MutedText" Color="#AAB5CC"/>
    <SolidColorBrush x:Key="FieldBackground" Color="#65141B2A"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF20283A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF20283A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFF8FAFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF4E6EA8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>

    <Style TargetType="TextBlock">
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,17,0,8"/>
      <Setter Property="Foreground" Value="#F7F9FF"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
      <Setter Property="Margin" Value="2,0,0,4"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
      <Setter Property="Foreground" Value="#F8FAFF"/>
      <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
      <Setter Property="Foreground" Value="#F8FAFF"/>
      <Setter Property="Background" Value="#FF20283A"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F8FAFF"/>
      <Setter Property="Background" Value="#FF20283A"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#FF40547D"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#FF4E6EA8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="15,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#35FFFFFF"/>
      <Setter Property="BorderBrush" Value="#55FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" CornerRadius="11"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.62"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.32"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4E8CFF" Offset="0"/>
            <GradientStop Color="#FF8D5CFF" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#99C7D9FF"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#75E24A68"/>
      <Setter Property="BorderBrush" Value="#AAFF9DB0"/>
    </Style>
    <Style x:Key="GlassCard" TargetType="Border">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#42FFFFFF" Offset="0"/>
            <GradientStop Color="#181B2842" Offset="0.52"/>
            <GradientStop Color="#28104A75" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#55FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="24"/>
    </Style>
  </Window.Resources>

  <Grid ClipToBounds="True">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#090C16" Offset="0"/>
        <GradientStop Color="#10182A" Offset="0.55"/>
        <GradientStop Color="#080B13" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <Ellipse Width="520" Height="520" Fill="#58408CFF"
             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-230,-260,0,0">
      <Ellipse.Effect><BlurEffect Radius="105"/></Ellipse.Effect>
    </Ellipse>
    <Ellipse Width="460" Height="460" Fill="#4836D8C9"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-210,-250">
      <Ellipse.Effect><BlurEffect Radius="110"/></Ellipse.Effect>
    </Ellipse>
    <Ellipse Width="280" Height="280" Fill="#357E4BFF"
             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="160,-280,0,0">
      <Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect>
    </Ellipse>

    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel>
        <StackPanel>
          <TextBlock Text="Deck Screen Share" FontSize="27" FontWeight="SemiBold"/>
          <TextBlock Text="Capture your Steam Deck over the local network"
                     Foreground="{StaticResource MutedText}" Margin="1,3,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Right" CornerRadius="16" Padding="13,8"
                Background="#24FFFFFF" BorderBrush="#45FFFFFF" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#69E7B1" Margin="0,0,8,0"/>
            <TextBlock Text="Local network" Foreground="#DCE5F7" FontSize="12"/>
          </StackPanel>
        </Border>
      </DockPanel>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="382"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="20">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,14,0">
            <StackPanel>
              <TextBlock Text="Connection" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
              <TextBlock Text="Steam Deck IP address" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="DeckHostBox" Text="192.168.1.50"/>
              <UniformGrid Columns="2">
                <StackPanel Margin="0,0,5,0">
                  <TextBlock Text="Agent port" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="DeckPortBox" Text="8765"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                  <TextBlock Text="This PC IP address" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="ReceiverHostBox"/>
                </StackPanel>
              </UniformGrid>

              <TextBlock Text="Encoding" Style="{StaticResource SectionTitle}"/>
              <UniformGrid Columns="2">
                <StackPanel Margin="0,0,5,0">
                  <TextBlock Text="Codec" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="CodecBox" SelectedIndex="0">
                    <ComboBoxItem Content="h264"/><ComboBoxItem Content="h265"/><ComboBoxItem Content="av1"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                  <TextBlock Text="Encoder" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="BackendBox" SelectedIndex="0">
                    <ComboBoxItem Content="software"/><ComboBoxItem Content="vaapi"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,5,0">
                  <TextBlock Text="Video, kbit/s" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="VideoBitrateBox" Text="8000"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                  <TextBlock Text="Audio, kbit/s" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="AudioBitrateBox" Text="160"/>
                </StackPanel>
                <StackPanel Margin="0,0,5,0">
                  <TextBlock Text="FPS" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="FpsBox" Text="60"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                  <TextBlock Text="SRT latency, ms" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="LatencyBox" Text="120"/>
                </StackPanel>
              </UniformGrid>

              <TextBlock Text="Capture and recording" Style="{StaticResource SectionTitle}"/>
              <UniformGrid Columns="2">
                <StackPanel Margin="0,0,5,0">
                  <TextBlock Text="Capture mode" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="CaptureModeBox" SelectedIndex="1">
                    <ComboBoxItem Content="x11grab"/><ComboBoxItem Content="kmsgrab"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                  <TextBlock Text="Container" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="ContainerBox" SelectedIndex="0">
                    <ComboBoxItem Content="mkv"/><ComboBoxItem Content="mp4"/><ComboBoxItem Content="mov"/>
                    <ComboBoxItem Content="webm"/><ComboBoxItem Content="ts"/>
                  </ComboBox>
                </StackPanel>
              </UniformGrid>
              <TextBlock Text="Display size" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="SizeBox" Text="1280x800"/>
              <TextBlock Text="Display" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="DisplayBox" Text=":0.0"/>
              <TextBlock Text="Audio source" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="AudioSourceBox" Text="@DEFAULT_MONITOR@"/>
              <TextBlock Text="Recording folder" Style="{StaticResource FieldLabel}"/>
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Browse" Click="Browse_Click"
                        Margin="8,0,0,9" Height="36" Padding="13,5"/>
                <TextBox x:Name="OutputFolderBox"/>
              </DockPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="5,2">
              <StackPanel>
                <TextBlock Text="Live preview" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Low-latency monitor from your Steam Deck"
                           Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0"/>
              </StackPanel>
              <Border DockPanel.Dock="Right" Background="#24FFFFFF" BorderBrush="#45FFFFFF"
                      BorderThickness="1" CornerRadius="12" Padding="10,6"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="SRT" FontSize="11" FontWeight="SemiBold" Foreground="#CDE1FF"/>
              </Border>
            </DockPanel>

            <Border Grid.Row="2" Background="#B0060910" BorderBrush="#45FFFFFF"
                    BorderThickness="1" CornerRadius="18" ClipToBounds="True">
              <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                <StackPanel x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border Width="58" Height="58" CornerRadius="29" Background="#28FFFFFF"
                          BorderBrush="#50FFFFFF" BorderThickness="1" Margin="0,0,0,13">
                    <TextBlock Text="▶" FontSize="21" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#DCE9FF"/>
                  </Border>
                  <TextBlock Text="Preview is waiting" FontSize="16" FontWeight="SemiBold"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="Test the connection or start recording"
                             Foreground="{StaticResource MutedText}" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="4" Background="#24FFFFFF" BorderBrush="#40FFFFFF"
                    BorderThickness="1" CornerRadius="16" Padding="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="#7EB7FF" Margin="0,0,9,0"/>
                  <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap"
                             Foreground="#DCE5F5" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="TestButton" Content="Test connection" Click="Test_Click"/>
                  <Button x:Name="StartButton" Content="Start recording" Click="Start_Click"
                          Style="{StaticResource PrimaryButton}"/>
                  <Button x:Name="StopButton" Content="Stop" Click="Stop_Click"
                          Style="{StaticResource DangerButton}" Margin="0" IsEnabled="False"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
