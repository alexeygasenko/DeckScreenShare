<Window x:Class="DeckScreenShare.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deck Screen Share" Width="1180" Height="760"
        MinWidth="980" MinHeight="650" Background="#10141C"
        Foreground="#EEF2F8" Closing="Window_Closing">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="350"/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Deck Screen Share" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock Text="Steam Deck" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="IP address"/>
        <TextBox x:Name="DeckHostBox" Text="192.168.1.50"/>
        <UniformGrid Columns="2">
          <StackPanel Margin="0,0,5,0"><TextBlock Text="Agent port"/><TextBox x:Name="DeckPortBox" Text="8765"/></StackPanel>
          <StackPanel Margin="5,0,0,0"><TextBlock Text="This PC IP"/><TextBox x:Name="ReceiverHostBox"/></StackPanel>
        </UniformGrid>

        <TextBlock Text="Encoding" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <UniformGrid Columns="2">
          <StackPanel Margin="0,0,5,0"><TextBlock Text="Codec"/><ComboBox x:Name="CodecBox" SelectedIndex="0"><ComboBoxItem Content="h264"/><ComboBoxItem Content="h265"/><ComboBoxItem Content="av1"/></ComboBox></StackPanel>
          <StackPanel Margin="5,0,0,0"><TextBlock Text="Encoder"/><ComboBox x:Name="BackendBox" SelectedIndex="0"><ComboBoxItem Content="software"/><ComboBoxItem Content="vaapi"/></ComboBox></StackPanel>
          <StackPanel Margin="0,0,5,0"><TextBlock Text="Video, kbit/s"/><TextBox x:Name="VideoBitrateBox" Text="8000"/></StackPanel>
          <StackPanel Margin="5,0,0,0"><TextBlock Text="Audio, kbit/s"/><TextBox x:Name="AudioBitrateBox" Text="160"/></StackPanel>
          <StackPanel Margin="0,0,5,0"><TextBlock Text="FPS"/><TextBox x:Name="FpsBox" Text="60"/></StackPanel>
          <StackPanel Margin="5,0,0,0"><TextBlock Text="SRT latency, ms"/><TextBox x:Name="LatencyBox" Text="120"/></StackPanel>
        </UniformGrid>

        <TextBlock Text="Capture and recording" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <UniformGrid Columns="2">
          <StackPanel Margin="0,0,5,0"><TextBlock Text="Mode"/><ComboBox x:Name="CaptureModeBox" SelectedIndex="1"><ComboBoxItem Content="x11grab"/><ComboBoxItem Content="kmsgrab"/></ComboBox></StackPanel>
          <StackPanel Margin="5,0,0,0"><TextBlock Text="Container"/><ComboBox x:Name="ContainerBox" SelectedIndex="0"><ComboBoxItem Content="mkv"/><ComboBoxItem Content="mp4"/><ComboBoxItem Content="mov"/><ComboBoxItem Content="webm"/><ComboBoxItem Content="ts"/></ComboBox></StackPanel>
        </UniformGrid>
        <TextBlock Text="Display size"/><TextBox x:Name="SizeBox" Text="1280x800"/>
        <TextBlock Text="Display"/><TextBox x:Name="DisplayBox" Text=":0.0"/>
        <TextBlock Text="Audio source"/><TextBox x:Name="AudioSourceBox" Text="@DEFAULT_MONITOR@"/>
        <TextBlock Text="Recording folder"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse..." Click="Browse_Click" Margin="7,3,0,8"/>
          <TextBox x:Name="OutputFolderBox"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="StartButton" Content="Start recording" Click="Start_Click" Background="#1479E6" Foreground="White"/>
          <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Background="#BD3E4B" Foreground="White" IsEnabled="False"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="2" Background="#05070A" BorderBrush="#2B3849" BorderThickness="1" CornerRadius="10">
      <Grid>
        <Image x:Name="PreviewImage" Stretch="Uniform"/>
        <TextBlock x:Name="PreviewHint" Text="Live preview will appear after recording starts"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8290A5"/>
      </Grid>
    </Border>

    <Border Grid.Column="2" VerticalAlignment="Bottom" Background="#D918202C" Padding="12" CornerRadius="7" Margin="12">
      <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
